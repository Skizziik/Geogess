# No keys are needed for the core game — Street View panoramas and the guess
# map are fully keyless (Google public embed + OpenStreetMap/CARTO tiles).

# Supabase (Realtime only, no database tables used). Required for multiplayer.
# Easiest: Vercel dashboard → Storage → Supabase — both vars are injected
# automatically. Manual setup: supabase.com → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Either of the two key formats works (the new publishable key or the legacy anon JWT):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
